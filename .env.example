# LowLex settings. Copy to .env next to the binary (or to the compose folder) and edit.

# Address and port. With Docker Compose these choose the published port on the host.
LOWLEX_HOST=0.0.0.0
LOWLEX_PORT=4747

# Where the database (lowlex.db) and the encryption key live.
LOWLEX_DATA_DIR=./lowlex_data

# First admin, created only when the database is empty.
# Leave the password empty to start with "lowlex", which must be changed at the first sign-in.
LOWLEX_ADMIN_USER=admin
LOWLEX_ADMIN_PASSWORD=

# External address when LowLex runs behind a proxy, e.g. https://lex.example.com.
# An https URL turns on secure cookies.
LOWLEX_PUBLIC_URL=

# Key that encrypts provider API keys at rest. Leave empty to generate lowlex_data/secret.key.
# If you set it, keep it: changing it makes saved provider keys unreadable.
LOWLEX_SECRET=

# Log every HTTP request.
LOWLEX_LOG_REQUESTS=false
